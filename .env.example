# Local Docker PostgreSQL (run: docker compose up -d)
DATABASE_URL="postgresql://leetcode:leetcode@localhost:5432/leetcode"
JWT_SECRET=your-strong-random-secret-min-32-chars
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
REDIS_URL=redis://localhost:6379

# Rate limiting (optional overrides)
# SUBMISSION_RATE_LIMIT_MAX=5
# SUBMISSION_RATE_LIMIT_WINDOW_SECONDS=60

# CORS (optional, comma-separated origins)
# CORS_ORIGIN=http://localhost:3000,http://localhost:5173
